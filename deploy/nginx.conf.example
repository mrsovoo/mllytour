# Millytour — frontend statik fayl sifatida, backend esa proksi orqali.
#
# Variant A (bitta domen, tavsiya etiladi):
#   millytour.uz/       → statik frontend (frontend/dist)
#   millytour.uz/api/   → Express backend (:4000)
#
# Bu holatda frontend `VITE_API_URL` bo'sh holda build qilinadi va sessiya
# cookie'si (`SameSite=Lax`) hech qanday qo'shimcha sozlamasiz ishlaydi.
#
# Foydalanish:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/millytour
#   sudo ln -s /etc/nginx/sites-available/millytour /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name millytour.uz www.millytour.uz;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name millytour.uz www.millytour.uz;

    ssl_certificate     /etc/letsencrypt/live/millytour.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/millytour.uz/privkey.pem;

    # 1) Statik frontend: `npm run build` natijasi (frontend/dist)
    root /var/www/millytour/frontend/dist;
    index index.html;

    # Hashed fayllar uchun uzoq kesh
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 2) API → Express backend
    location /api/ {
        proxy_pass         http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        # Backend shu sarlavha orqali HTTPS'ni biladi va cookie'ni `Secure` qiladi
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # 3) SPA fallback — noma'lum marshrutlar index.html ga (react-router uchun)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
