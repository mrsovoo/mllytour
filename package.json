{
  "name": "millytour-root",
  "private": true,
  "workspaces": [
    "frontend",
    "admin",
    "backend",
    "bot"
  ],
  "scripts": {
    "build": "npm run build --workspace=backend",
    "start": "npm start --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:bot": "npm run dev --workspace=bot",
    "build:frontend": "npm run build --workspace=frontend",
    "build:admin": "npm run build --workspace=admin",
    "build:backend": "npm run build --workspace=backend",
    "build:bot": "npm run build --workspace=bot",
    "build:all": "npm run build:backend && npm run build:frontend && npm run build:admin && npm run build:bot",
    "test:backend": "npm run test --workspace=backend"
  }
}
