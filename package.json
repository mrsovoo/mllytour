{
  "name": "millytour",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node backend/server/dev.mjs",
    "dev:admin": "node backend/server/dev.mjs --panel=admin",
    "dev:partner": "node backend/server/dev.mjs --panel=partner",
    "dev:web": "npm run dev -w millytour-frontend",
    "start:api": "npm run start -w millytour-backend",
    "seed": "npm run seed -w millytour-backend --",
    "bots": "npm run bots -w millytour-backend --",
    "build": "npm run build -w millytour-frontend",
    "typecheck": "npm run typecheck -w millytour-frontend",
    "lint": "npm run lint -w millytour-frontend",
    "preview": "npm run preview -w millytour-frontend",
    "format": "prettier --write .",
    "audit:ui": "node scripts/ui-audit.mjs",
    "audit:admin": "node scripts/ui-audit.mjs --admin --base=http://127.0.0.1:3000",
    "ai:setup": "node scripts/ai-setup.mjs"
  },
  "devDependencies": {
    "prettier": "3.7.3"
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "sqlite3@5.1.7": true
  }
}
