# Local backend
# Frontend API'ni qaysi manzildan chaqiradi. Bo'sh bo'lsa nisbiy `/api/...` ishlaydi
# (dev'da Vite proxy, prod'da bir xil domendagi nginx/rewrite). Backend alohida
# domenda bo'lsa to'liq manzil yoziladi va frontend qayta build qilinadi:
# VITE_API_URL=https://api.millytour.uz
VITE_API_URL=
SITE_URL=http://localhost:5173
SHOW_DEV_OTP=true

# --- Seed (`npm run seed`) ---
# Super admin emaili. Bo'sh bo'lsa admin@millytour.uz ishlatiladi.
SEED_ADMIN_EMAIL=
# Baza fayli boshqa joyda bo'lsa (serverda, masalan /var/lib/millytour/millytour.db)
DATABASE_PATH=

# --- Frontend va backend alohida serverlarda (deploy/README.md ga qarang) ---
# Backend qaysi saytlardan so'rov qabul qiladi (vergul bilan ajratiladi).
# Bo'sh qoldirilsa har qanday origin qabul qilinadi — bu faqat lokal dev uchun.
CORS_ORIGIN=
# Sessiya cookie'si. Subdomenlar (millytour.uz + api.millytour.uz) uchun "lax"
# yetarli; butunlay boshqa saytlar uchun "none" + COOKIE_SECURE=true shart.
COOKIE_SAME_SITE=
COOKIE_SECURE=
COOKIE_DOMAIN=

# Admin-only rejim: `npm run dev:admin` (localhost:3000) va millytour-adm.* domeni
# uchun deploy'da "1" qilib qo'yiladi. Default — sayt (public) rejimi.
VITE_ADMIN_ONLY=

# AI / Groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b

# --- Telegram botlar ---
# Uchta bot: main (mijozlar), auth (kirishni tasdiqlash), stats (egasi uchun).
# Token bu yerda bo'sh qolsa ham botlar ishlaydi: admin panel yoki
# `npm run bots -- --main=TOKEN --auth=TOKEN --stats=TOKEN` orqali bazaga
# yozilgan tokenlar ustun turadi (serverda qayta ishga tushirish shart emas).
TELEGRAM_MAIN_BOT_TOKEN=
TELEGRAM_AUTH_BOT_TOKEN=
TELEGRAM_STATS_BOT_TOKEN=
TELEGRAM_MAIN_BOT_USERNAME=mllytour_bot
TELEGRAM_AUTH_BOT_USERNAME=mtour_auth_bot
TELEGRAM_STATS_BOT_USERNAME=mtour_by_statik_bot
# Loyiha egasining Telegram ID'si (statistikani shu chatga yuboradi).
OWNER_TELEGRAM_ID=
# Lokalda webhook HTTPS talab qilgani uchun long-polling ishlatiladi.
# "true" bo'lsa botlar Telegramdan xabarlarni o'zi olib turadi.
TELEGRAM_POLLING=

# Google auth (optional)
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Dodo Payments (optional)
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_ID=

# Optional AI provider keys
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VLY_INTEGRATION_KEY=
